# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Recordings. test.mp4 alone is 52 MB; GitHub warns above 50 MB and rejects
# above 100 MB, and a capture of a run is not source.
*.mp4
*.avi
*.gif
frames/

# Measurement output. These are regenerated by tools/ in minutes and are
# specific to one machine's seeds, so they are noise in a diff.
out_*.json
err_*.txt
*.log
scratch/

# One-off analysis scripts written to answer a single question during a
# debugging session. Kept on disk, deliberately out of the repo -- they refer
# to code paths that have since been rewritten and would mislead a reader.
*_tmp.py
analyze.py
analyze2.py
instrument_openplay.py

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
